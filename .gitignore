# ==============================================================================
# Git Ignore - SAMUDRAX Platform
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 3D Model Source Files (Blender / CAD / Heavy Meshes)
/models/
*.blend
*.blend1
*.blend2
*.fbx
*.obj
*.stl
*.dae
*.3ds

# Unused / Raw 3D Model Exports
public/models/
website/public/models/*
# Keep only the active production GLB models required by the website
!website/public/models/samudrax-complete-v8.glb
!website/public/models/samudrax-exploded-v8.glb
!website/public/models/samudrax-scroll-explode.glb

# Large Video Files & Renders (Exceeds Git / GitHub 100MB file limits)
/Videos/
website/public/videos/*
!website/public/videos/turbine-web.mp4
*.mov
*.mkv
*.avi

# Node Dependencies
node_modules/
website/node_modules/

# Production Builds
dist/
dist-ssr/
website/dist/
website/dist-ssr/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Local Configs
.env
.env.*
!.env.example
*.local

# IDE & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
